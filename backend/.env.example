# AI & Model Providers
AI_PROVIDER=gemini
LLM_PROVIDER=gemini
STT_PROVIDER=groq
TTS_PROVIDER=edge

# Voice Settings (Microsoft Edge Neural TTS - 100% Free)
EDGE_TTS_VOICE=gu-IN-NiranjanNeural
EDGE_TTS_LANG=gu-IN

# Google Gemini API Settings (100% Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=15000

# Groq Cloud Settings (Whisper STT - 100% Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=15000
LLM_FALLBACK_PROVIDER=groq

# Speech-to-Text Settings
STT_LANGUAGE=auto
STT_PROMPT="KOTL, assistant, smart robot, Gujarati, Hinglish"

# Server Port
PORT=3000
